# LLM (API compatible con OpenAI: Groq u OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=1024
LLM_FALLBACK_MODELS=

# RAG
PINECONE_API_KEY=
PINECONE_INDEX=intelligence-system
PINECONE_NAMESPACE=futbol
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
RAG_TOP_K=3
RAG_BM25_WEIGHT=0.3

# Redis
REDIS_URL=redis://localhost:6379/0
CHECKPOINTER_BACKEND=redis
JOB_TTL_SECONDS=86400
WORKER_CONCURRENCY=1

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=intelligence-system

# Opcional
TAVILY_API_KEY=

# Límites del grafo
MAX_STEPS=6
MAX_VALIDATION_ROUNDS=2
RECURSION_LIMIT=40
